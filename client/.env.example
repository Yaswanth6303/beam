# Base URL of the Express + Socket.IO server (server/)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional TURN relay, needed in production for users behind strict NATs or
# firewalls. Comma-separated URLs, e.g.
#   turn:turn.example.com:3478,turns:turn.example.com:5349
# These values ship to the browser, so use a provider's time-limited
# credentials or a TURN server with its own abuse limits.
# NEXT_PUBLIC_TURN_URLS=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
