PORT=8000
MONGO_URI=mongodb://root:root@localhost:27017/beam?authSource=admin
# Required. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Origins allowed to call the API and open sockets (the Next.js client).
# Comma-separated for more than one.
CLIENT_ORIGIN=http://localhost:3000
# Set to 1 only when running behind one reverse proxy (Nginx, a load balancer),
# so rate limiting sees real client IPs.
# TRUST_PROXY=1
